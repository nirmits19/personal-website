# WordPress REST API that the /essay pages read from
WP_API_URL=https://essay.eudaimonias.me/wp-json/wp/v2

# Only needed if the REST API is locked to logged-in users
# (e.g. the "Disable REST API" plugin). Create an Application Password
# under Users → Profile on a low-privilege account and paste it here.
WP_APP_USER=
WP_APP_PASSWORD=

# How long fetched essays are cached in memory, in seconds.
# 0 = always ask WordPress, so approvals show immediately (recommended).
# Only raise this if WordPress can't keep up with traffic; then also set
# up the /api/wp-revalidate hook below so approvals still show instantly.
WP_CACHE_TTL_SECONDS=0

# Optional, only useful when WP_CACHE_TTL_SECONDS > 0. Shared secret for
# /api/wp-revalidate; put the same value in the WordPress snippet
# (README-wordpress.md). Leave empty to disable the hook.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_SECRET=

# Public URL of this site, used for canonical and og:url tags
SITE_URL=https://www.eudaimonias.me
